<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Doctor.Gui.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />

        <!-- ============================================================
             Visual security system (G2 — t_87f625aa; §37, ADR-0009).
             Single button vocabulary for ALL screens:
               primary    — safe recommended action (blue);
               destructive— moves user content to quarantine
                            (red; never permanent removal — ADR-0002);
               secondary  — navigation/reconsider (neutral).
             The destructive affordance is NEVER shared with compare/navigate.
             ============================================================ -->

        <!-- Primary button: safe and recommended action (blue). -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- Destructive button: moves user content to quarantine (red).
             Never represents permanent removal — only auditable movement. -->
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="#C93C37" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- Secondary button: navigation and reconsideration (neutral, unhighlighted). -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E9ECEF" />
            <Setter Property="Foreground" Value="#212529" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- Common typography for screens. -->
        <Style Selector="TextBlock.titulo">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="TextBlock.resposta">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
