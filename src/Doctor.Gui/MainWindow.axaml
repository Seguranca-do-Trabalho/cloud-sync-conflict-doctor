<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Doctor.Gui.ViewModels"
        xmlns:engine="using:Doctor.Gui.Engine"
        x:Class="Doctor.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cloud Sync Conflict Doctor"
        Width="860" Height="600">

    <Window.Styles>
        <!-- Safety styles (primary/destructive/secondary) are CENTRALIZED
             in App.axaml (G2 — t_87f625aa): all screens inherit the same vocabulary. -->
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="24">

        <Panel Grid.Row="0">

            <!-- 1. Choose Folder -->
            <StackPanel IsVisible="{Binding ShowChooseFolder}" Spacing="12">
                <TextBlock Classes="titulo" Text="Choose Folder" />
                <TextBlock Text="Which folder do you want to scan for duplicate and sync conflict files?" TextWrapping="Wrap" />
                <TextBox Watermark="C:\Users\you\OneDrive" Text="{Binding ChosenFolder}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Scan Folder" Command="{Binding StartScanCommand}" />
                </StackPanel>
                <TextBlock Text="Demo: no files are read; the result is a fixed sample (DEMO)." Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 2. Scanning (fake progress) -->
            <StackPanel IsVisible="{Binding ShowScanning}" Spacing="12" VerticalAlignment="Center">
                <TextBlock Classes="titulo" Text="Scanning…" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanProgressPercent}" Height="8" />
                <TextBlock Text="{Binding ScanProgressPercent, StringFormat='{}{0}%'}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 3. Summary: the 5 questions from §15 -->
            <StackPanel IsVisible="{Binding ShowSummary}" Spacing="8">
                <TextBlock Classes="titulo" Text="Summary" />
                <TextBlock Text="Files found:" />
                <TextBlock Classes="resposta" Text="{Binding SummaryFilesFound}" />
                <TextBlock Text="Identical duplicates (redundant copies):" />
                <TextBlock Classes="resposta" Text="{Binding SummaryIdenticalDuplicates}" />
                <TextBlock Text="Real conflicts:" />
                <TextBlock Classes="resposta" Text="{Binding SummaryRealConflicts}" />
                <TextBlock Text="Placeholders ignored (never opened):" />
                <TextBlock Classes="resposta" Text="{Binding SummaryPlaceholdersIgnored}" />
                <TextBlock Text="Space that can be safely recovered:" />
                <TextBlock Classes="resposta" Text="{Binding SummaryRecoverableSpace}" />
                <TextBlock Foreground="Green"
                           Text="No cloud file bytes were read: placeholders remain untouched." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                    <Button Classes="primary" Content="View Duplicates" Command="{Binding OpenDuplicatesCommand}" />
                    <Button Classes="secondary" Content="View Real Conflicts" Command="{Binding OpenConflictsCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 4. Duplicates -->
            <StackPanel IsVisible="{Binding ShowDuplicates}" Spacing="10">
                <TextBlock Classes="titulo" Text="Identical Duplicates" />
                <ItemsControl ItemsSource="{Binding Report.IdenticalDuplicates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="engine:DuplicateGroup">
                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes each'}" />
                                    <TextBlock Foreground="Gray" FontSize="11"
                                               Text="{Binding Blake3Hash, StringFormat='BLAKE3 {0}'}" />
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Continue" Command="{Binding OpenConflictsCommand}" />
                    <Button Classes="secondary" Content="Back to Summary" Command="{Binding GoBackCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 5. Real Conflicts -->
            <StackPanel IsVisible="{Binding ShowConflicts}" Spacing="10">
                <TextBlock Classes="titulo" Text="Real Conflicts" />
                <ItemsControl ItemsSource="{Binding Report.RealConflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="engine:ConflictGroup">
                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding BaseName}" />
                                    <TextBlock Foreground="Gray" Text="{Binding Versions.Count, StringFormat='{}{0} divergent versions'}" />
                                    <Button Classes="primary" Content="Compare Versions"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CompareConflictCommand}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary" Content="Back to Duplicates" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- 6. Compare -->
            <StackPanel IsVisible="{Binding ShowCompare}" Spacing="10">
                <TextBlock Classes="titulo" Text="Compare Versions" />
                <TextBlock FontWeight="SemiBold" Text="{Binding SelectedConflict.BaseName}" />
                <ItemsControl ItemsSource="{Binding SelectedConflict.Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="engine:ConflictVersion">
                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="Gray" FontSize="12"
                                               Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}" />
                                    <TextBlock Foreground="Gray" FontSize="12"
                                               Text="{Binding MtimeUtc, StringFormat='modified on {0}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock>
                    <Run Text="Auto-suggestion: keep '" /><Run Text="{Binding SelectedVersionToKeep.Path}" /><Run Text="' (newest; tiebreak by size and path)." />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="destructive" Content="Move Other Versions to Quarantine"
                            Command="{Binding QueueOtherVersionsForQuarantineCommand}" />
                    <Button Classes="secondary" Content="Back to Conflicts" Command="{Binding GoBackCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 7. Choose Action -->
            <StackPanel IsVisible="{Binding ShowChooseAction}" Spacing="12">
                <TextBlock Classes="titulo" Text="Choose Action" />
                <TextBlock TextWrapping="Wrap"
                           Text="Versions that will not be kept go to a dated quarantine folder, with a manifest for restoration. Nothing is discarded immediately." />
                <TextBlock Text="{Binding Quarantine.CountLabel, StringFormat='{}{0} items in queue'}" />

                <!-- §17 Strategies: FIXED list, visual presentation only.
                     Resolution logic belongs to EPIC 07 (scheduled) — extension point. -->
                <TextBlock FontWeight="SemiBold" Text="How do you want to decide between versions?" />
                <ItemsControl ItemsSource="{x:Static vm:MainWindowViewModel.ResolutionStrategies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                <Ellipse Width="8" Height="8" Fill="#1F6FEB"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                           Text="Version tiebreak always resolved in order: mtime → size → path (modification date, then size, then path)." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="destructive" Content="Move to Quarantine Now"
                            Command="{Binding ConfirmQuarantineCommand}" />
                    <Button Classes="secondary" Content="Rethink" Command="{Binding GoBackCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 8. Quarantine -->
            <StackPanel IsVisible="{Binding ShowQuarantine}" Spacing="10">
                <TextBlock Classes="titulo" Text="Quarantine" />
                <TextBlock TextWrapping="Wrap"
                           Text="Items prepared for quarantine move (skeleton: no real files are touched):" />
                <ItemsControl ItemsSource="{Binding Quarantine.Paths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Record Quarantine Move"
                            Command="{Binding OpenConfirmationFromQuarantineCommand}" />
                    <Button Classes="secondary" Content="Back" Command="{Binding GoBackCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 9. Confirmation: fake §18 manifest displayed BEFORE the final action.
                 Deterministic operation_id, count, and expected path. -->
            <StackPanel IsVisible="{Binding ShowConfirmation}" Spacing="12" VerticalAlignment="Center">
                <TextBlock Classes="titulo" Text="Done" />
                <TextBlock TextWrapping="Wrap"
                           Text="The quarantine move has been recorded. A manifest allows restoring any item later." />
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="This operation's manifest (demonstration):" />
                        <TextBlock FontSize="12"
                                   Text="{Binding ExpectedOperationId, StringFormat='operation_id: {0}'}" />
                        <TextBlock FontSize="12"
                                   Text="{Binding ConfirmationItemCount, StringFormat='items in queue: {0}'}" />
                        <TextBlock FontSize="12"
                                   Text="{x:Static vm:MainWindowViewModel.ExpectedQuarantinePathLabel}" />
                    </StackPanel>
                </Border>
                <TextBlock Foreground="Green" Text="No files were discarded — everything remains recoverable in quarantine." TextWrapping="Wrap" />
                <Button Classes="primary" Content="Browse Another Folder" Command="{Binding RestartCommand}" HorizontalAlignment="Left" />
            </StackPanel>

        </Panel>

        <TextBlock Grid.Row="1" Foreground="Gray" FontSize="11" Margin="0,12,0,0"
                   Text="DEMO — skeleton with fake engine; dummy data; no real file operations." />

    </Grid>
</Window>
