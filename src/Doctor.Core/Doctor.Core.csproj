<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- P/Invoke lstat with a direct pointer (card T07): avoids marshaling a large
         struct and keeps the binary layout explicit. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned version in Directory.Packages.props (ADR-0005 §1; risk R9). -->
    <PackageReference Include="Blake3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Incremental cache (SPEC §12; ADR-0001/ADR-0006): version PINNED in
         Directory.Packages.props (supply chain R9; ADR-0006 §1). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests prove the v1 recipe segment-by-segment via spy streams and
         inspect raw cache lines (CACHE family). -->
    <InternalsVisibleTo Include="Doctor.Tests" />
  </ItemGroup>

</Project>
