<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!-- Executable name from SPEC 14 (json and quiet options on the scan command). -->
    <AssemblyName>conflictdoctor</AssemblyName>
    <RootNamespace>Doctor.Cli</RootNamespace>
    <!-- CLI must not degrade the product (SPEC §14): no framework log output
         on stdout when in JSON mode. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Doctor.Core/Doctor.Core.csproj" />
  </ItemGroup>

</Project>
