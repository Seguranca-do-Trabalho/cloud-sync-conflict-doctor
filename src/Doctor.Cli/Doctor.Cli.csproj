<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!-- Nome do executavel da SPEC 14 (opcoes json e quiet no comando scan). -->
    <AssemblyName>conflictdoctor</AssemblyName>
    <RootNamespace>Doctor.Cli</RootNamespace>
    <!-- CLI não pode degradar o produto (SPEC §14): nenhum log de framework na saída
         padrão em modo JSON. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Doctor.Core/Doctor.Core.csproj" />
  </ItemGroup>

</Project>
