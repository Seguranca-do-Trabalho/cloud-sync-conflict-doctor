<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Module thresholds (lines): fails the build if below. -->
          <!-- docs/test-strategy.md §7: Core>=85%, Cli>=75%, Gui ViewModels>=60%. -->
          <!-- The CLI is no longer in repo (merged in EPIC 09); Cli threshold omitted. -->
          <CollectionThreshold>0.85</CollectionThreshold>
          <!-- Exclusions: views/code-behind and generated code. -->
          <Exclude>[xunit.*]*</Exclude>
          <ExcludeByFile>**/obj/**,**/bin/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
