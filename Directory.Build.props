<Project>

  <!--
    Define the WINDOWS symbol when building on Windows.

    WHY THIS EXISTS
    The code uses `#if WINDOWS` in three places (CrossPlatformEnumerator,
    WindowsNativeEnumerator, and native tests), but NOTHING defined this symbol:
    the projects have TargetFramework net8.0 (not net8.0-windows), and there was no
    Directory.Build.props. Measured consequences before this fix:

      - CrossPlatformEnumerator always fell into the #else branch and called
        LinuxFileId.GetInode(), a P/Invoke of lstat(2). On Windows this throws
        DllNotFoundException ('libc'), the catch swallowed the error and DISCARDED the
        file: the enumeration returned ZERO files in a tree with 2.
      - The entire native body of WindowsNativeEnumerator (P/Invoke
        FindFirstFileExW, delivered in commit 42ed47c/T23) was never compiled.
      - The four WindowsNativeEnumeratorTests start with
        `#if !WINDOWS return; #endif`, so they returned immediately and passed
        without exercising anything — on any platform, including the Windows
        CI runner. The compiler warned (CS0162, unreachable code).

    Effect: 29 of the 541 tests failed on Windows, all from this single root cause.

    The condition uses $(OS), evaluated by MSBuild on the build machine. On
    Linux the symbol is NOT defined and everything follows the POSIX path, preserving
    the Linux CI job.
  -->
  <PropertyGroup>
    <Authors>forg3</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

</Project>
